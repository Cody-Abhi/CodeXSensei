# TinyFish SDK — Search / Fetch / Agent. Read server-side only.
# Get a key at https://tinyfish.ai
TINYFISH_API_KEY=your_tinyfish_api_key_here

# Anthropic — used for LLM extraction (model: claude-sonnet-5-5). Server-side only.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
