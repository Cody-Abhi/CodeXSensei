# TinyFish SDK — Search / Fetch / Agent. Read server-side only.
# Get a key at https://tinyfish.ai
TINYFISH_API_KEY=your_tinyfish_api_key_here

# Google Gemini — used for LLM extraction (model: gemini-2.5-flash). Server-side only.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model (default gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Optional: enable the Unstop source via the TinyFish Agent API (stealth browser)
# EVENTRADAR_ENABLE_UNSTOP=1
